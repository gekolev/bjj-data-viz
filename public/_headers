# Only Vite-fingerprinted output belongs under /assets/.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML and SPA fallbacks revalidate; these rules do not overlap /assets/*.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/log
  Cache-Control: no-cache
/sessions
  Cache-Control: no-cache
/wrapped
  Cache-Control: no-cache
/dev
  Cache-Control: no-cache
/instructions
  Cache-Control: no-cache
/welcome
  Cache-Control: no-cache
/favicon.svg
  Cache-Control: public, max-age=3600
/icons.svg
  Cache-Control: public, max-age=3600
